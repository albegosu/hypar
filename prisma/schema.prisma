generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Embryo domain ─────────────────────────────────────────────

enum EmbryoState {
  LATENT
  GERMINATING
  GROWING
  MATURING
  FOSSIL
  TRANSPLANTED
}

enum EventType {
  CREATED
  STATE_CHANGED
  TENSION_ADDED
  TENSION_RESOLVED
  CONNECTION_MADE
  AGENT_QUESTION
  AGENT_SUGGESTION
  USER_RESPONSE
  FOSSIL_PROPOSED
  FOSSILIZED
  TRANSPLANT_PROPOSED
  TRANSPLANTED
  USER_NOTE
  RESEARCHED
  GERMINATE_NOTICE
  VALIDATION_PLAN_SET
}

// What a web finding does to the idea (ADR 0007)
enum ResearchStance {
  REFUTE
  EXTEND
}

enum EventInitiator {
  USER
  AGENT
  SYSTEM
}

enum ConnectionType {
  REINFORCES
  CONTRADICTS
  EXTENDS
  RESURRECTS
}

enum AgentNoteType {
  OBSERVATION
  PENDING_QUESTION
  PENDING_CONNECTION
  PENDING_FOSSIL
  PENDING_PATH
  PENDING_TRANSPLANT
  PENDING_VALIDATION_PLAN
}

enum FossilTrigger {
  USER
  AGENT
}

model Embryo {
  id           String      @id @default(cuid())
  userId       String
  seed         String      // Raw original thought — never edited after creation
  state        EmbryoState @default(LATENT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  fossilizedAt DateTime?
  fossilReason String?     // Required when fossilizing
  fossilBy     FossilTrigger?
  transplantedAt    DateTime?
  transplantReason  String?   // Required when transplanting: what made it work
  transplantOutcome String?   // What it became: a URL or a reference (component, doc, repo, skill)
  sourceUrl    String?     // Original link when the seed arrived from an integration (e.g. second-brain)
  sourceRef    String?     // Where the integration keeps its own copy (e.g. the wiki source note)
  sourceTitle  String?     // Title of what sparked the seed (e.g. the capture's title)
  sourceContext String?    // What sparked the seed, as Markdown: the capture's essence, never the seed itself
  validationPlan String?   // ADR 0010 (proposed): how this idea gets validated; agent proposes, user accepts or edits

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       EmbryoEvent[]
  tensions     Tension[]
  connections  Connection[]  @relation("ConnectionSource")
  connectedTo  Connection[]  @relation("ConnectionTarget")
  agentNotes   AgentNote[]

  @@index([userId, state])
  @@index([userId, createdAt])
  @@index([userId, sourceUrl])
}

model EmbryoEvent {
  id          String         @id @default(cuid())
  embryoId    String
  type        EventType
  initiatedBy EventInitiator
  payload     Json?          // Type-specific data (e.g. old/new state, tension id)
  createdAt   DateTime       @default(now())

  embryo      Embryo         @relation(fields: [embryoId], references: [id], onDelete: Cascade)

  @@index([embryoId, createdAt])
}

model Tension {
  id         String         @id @default(cuid())
  embryoId   String
  question   String
  resolved   Boolean        @default(false)
  raisedBy   EventInitiator
  resolvedAt DateTime?
  createdAt  DateTime       @default(now())
  // Web research (ADR 0007): the sourced finding behind an agent tension.
  claim       String?
  stance      ResearchStance?
  sourceUrl   String?
  sourceTitle String?

  embryo     Embryo         @relation(fields: [embryoId], references: [id], onDelete: Cascade)

  @@index([embryoId, resolved])
}

model Connection {
  id              String         @id @default(cuid())
  sourceId        String
  targetId        String
  type            ConnectionType
  detectedBy      EventInitiator
  confirmedByUser Boolean        @default(false) // Agent-detected connections need user confirmation
  note            String?
  createdAt       DateTime       @default(now())

  source          Embryo         @relation("ConnectionSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target          Embryo         @relation("ConnectionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

model AgentNote {
  id        String        @id @default(cuid())
  embryoId  String
  type      AgentNoteType
  content   String
  dismissed Boolean       @default(false)
  createdAt DateTime      @default(now())

  embryo    Embryo        @relation(fields: [embryoId], references: [id], onDelete: Cascade)

  @@index([embryoId, type])
}

// ── Integrations ──────────────────────────────────────────────

// Personal token an external tool (e.g. second-brain) uses to write into one
// user's garden. Only the SHA-256 hash is stored; the token is shown once.
model IntegrationToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Latest index of the user's second-brain wiki (topic and item names, summaries),
// pushed by the wiki repository. One row per user, replaced on every push.
model ReferenceIndex {
  id        String   @id @default(cuid())
  userId    String   @unique
  markdown  String
  commit    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── LLM provider (ADR 0008) ───────────────────────────────────

enum LlmProvider {
  ANTHROPIC
  OPENAI
  OLLAMA_CLOUD
}

// The user's own LLM provider. One per user. The API key is encrypted at rest
// (AES-256-GCM, server/utils/secret-box.ts) and never returned to the client.
// Without a row the server-wide fallback (env Ollama) is used.
model ProviderConnection {
  id                String      @id @default(cuid())
  userId            String      @unique
  provider          LlmProvider
  apiKeyCiphertext  String
  apiKeyHint        String
  collaboratorModel String?
  // Optional per-role overrides (ADR 0008 amendment). Null falls back to collaboratorModel.
  researchModel     String?
  criticModel       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Per-user preferences. No row means the defaults.
model UserSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  // ADR 0007: the idea's text may go to the provider's web search.
  webResearch  Boolean  @default(true)
  // Research before the agent's question when an embryo enters GERMINATING or MATURING.
  autoResearch Boolean  @default(false)
  // Open question "what triggers germination": the agent engages on first open, or waits to be invited.
  autoEngage   Boolean  @default(true)
  // Open question "what does the agent know": how many living peers it sees (fossils stay at 5).
  peerLimit    Int      @default(15)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── better-auth tables ────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  Session[]
  accounts  Account[]
  embryos   Embryo[]
  integrationTokens IntegrationToken[]
  referenceIndex    ReferenceIndex?
  providerConnection ProviderConnection?
  settings           UserSettings?
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime?
}
